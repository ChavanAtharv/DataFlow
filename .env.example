# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dataflow
DB_USER=dataflow
DB_PASSWORD=dataflow_secret

# Spark Configuration
SPARK_APP_NAME=DataFlowTransformation
SPARK_MASTER=local[*]
SPARK_JDBC_JAR=/usr/share/java/postgresql-jdbc.jar

